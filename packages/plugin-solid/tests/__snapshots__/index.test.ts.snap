exports[`plugin-solid > should allow deprecated solidPresetOptions alias 1`] = `
{
  "dependency": {
    "not": "url",
  },
  "include": [
    {
      "not": /\\[\\\\\\\\/\\]node_modules\\[\\\\\\\\/\\]/,
    },
    /\\\\\\.\\(\\?:ts\\|tsx\\|jsx\\|mts\\|cts\\)\\$/,
  ],
  "resourceQuery": {
    "not": /\\[\\?&\\]raw\\(\\?:&\\|=\\|\\$\\)/,
  },
  "test": /\\\\\\.\\(\\?:js\\|jsx\\|mjs\\|cjs\\|ts\\|tsx\\|mts\\|cts\\)\\$/,
  "use": [
    {
      "loader": "<ROOT>/packages/plugin-solid/src/solidLoader.mjs",
      "options": {
        "compiler": "native",
        "solid": {
          "builtIns": [
            "For",
            "Show",
            "Switch",
            "Match",
            "Loading",
            "Reveal",
            "Portal",
            "Repeat",
            "Dynamic",
            "Errored",
          ],
          "contextToCustomElements": true,
          "dev": false,
          "generate": "ssr",
          "hydratable": true,
          "moduleName": "@solidjs/web",
          "wrapConditionals": true,
        },
      },
    },
    {
      "loader": "<ROOT>/packages/plugin-solid/src/refreshLoader.mjs",
    },
  ],
  "with": {
    "type": {
      "not": "text",
    },
  },
}
`;

